# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/
# The documentation site built by `zensical build` (and its cache).
/site/
/.cache/

# Local environment / external-data paths (see .env.example, which IS tracked).
.env

# Project data that must not be committed
# PIDE is distributed only after registration with an institutional e-mail
# (https://www.gsi.de/.../pide_project) and must NOT be redistributed.
# data/pide/ is the default local folder the loader reads from; drop your own
# PIDE export there. Everything in it is ignored EXCEPT the tracked README.
/data/pide/*
!/data/pide/README.md
# The PIDE publication -> PMID bridge is built from PIDE's reference list: local only.
pide_publications_pmid*.csv
*.PIDE
*.pide
# Raw water stopping-power sources (NIST PSTAR/ASTAR, the ICRU 90 addendum, MSTAR,
# NIST isotope masses, ICRU 73): fetched by scripts/stopping/fetch_sources.py and
# never committed. Only each source's PROVENANCE.md (origin, citation, notice,
# checksums), a per-source README (data format) and the folder README are tracked. What ships is our own regridded
# tables in pyradbio/track/stopping/data/.
/data/stopping/*/**
!/data/stopping/*/PROVENANCE.md
!/data/stopping/*/README.md
benchmark_results/
# alpha/beta tables written by `pyradbio table` (regenerate from the
# model_config header the CLI records in each file).
tables_*/

# Jupyter / jupytext
.ipynb_checkpoints/
# Notebooks are generated from the jupytext .py sources (the source of truth).
examples/**/*.ipynb
# Example figures are generated by running the example scripts.
examples/figures/
# Validation figures likewise; validation/data/ (our own offline-MC checkpoints)
# IS tracked.
validation/figures/

# Editors / OS / agent tooling
.idea/
.vscode/
.codex/
.DS_Store
