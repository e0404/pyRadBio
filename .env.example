# pyRadBio external reference-data locations.
#
# Copy this file to `.env` (git-ignored) and point each variable at the folder
# where you keep that data type. Third-party reference/benchmark data is NOT
# committed to this repository (see AGENTS.md and THIRD_PARTY_NOTICES.md); only
# self-digitised paper data is bundled in the package.
#
# Paths may use `~` and forward slashes on every platform (pathlib normalises
# them on Windows). Variables already exported in your shell / CI take priority
# over this file. Resolution and error messages live in `pyradbio/datasets.py`.

# PIDE database (GSI; registration required, not redistributable).
# Loader also falls back to the git-ignored ./data/pide/ folder if unset.
PYRADBIO_PIDE_DIR=/path/to/biodata/pide

# RadPhysBio database export (NTUA; Zanni et al. 2024, CC BY 4.0). Export the CSV
# from https://radbiodb.physics.ntua.gr/radphysbio/ into this folder.
PYRADBIO_RADPHYSBIO_DIR=/path/to/biodata/RadPhysBio

# TRiP98 reference tables. Base folder containing DEDX/ and RBE/{LEM1,LEM4}/.
PYRADBIO_TRIP98_DIR=/path/to/biodata/TRIP98

# "batuff/Survival"-code JSON exports (e.g., rapidLEM, rapid mMKM); the *.json sit directly here.
PYRADBIO_SURVIVAL_DIR=/path/to/biodata/Survival

# DeCunha 2025 lineal-energy spectrum library (Geant4-DNA). Other lineal-energy
# sources get their own PYRADBIO_LINEAL_ENERGY_<SOURCE>_DIR variable.
PYRADBIO_LINEAL_ENERGY_DECUNHA_DIR=/path/to/biodata/LinealEnergySpectra/Library/csv

# batuff/Survival SOURCE checkout (GPL-2). Its data/ holds the SRIM <Ion>_Srim.dat
# stopping-power tables and eta_Elsasser2007.dat. Distinct from PYRADBIO_SURVIVAL_DIR above.
PYRADBIO_SURVIVAL_SRC_DIR=/path/to/src/Survival
